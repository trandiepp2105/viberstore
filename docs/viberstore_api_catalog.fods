<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.2"><office:automatic-styles><style:style style:name="ce1" style:family="table-cell"><style:table-cell-properties fo:background-color="#1F4E78"/><style:text-properties fo:color="#FFFFFF" fo:font-weight="bold"/></style:style><style:style style:name="ce2" style:family="table-cell"><style:table-cell-properties fo:wrap-option="wrap"/></style:style></office:automatic-styles><office:body><office:spreadsheet><table:table table:name="Danh sách API"><table:table-row><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>Nhóm</text:p></table:table-cell><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>Method</text:p></table:table-cell><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>Endpoint</text:p></table:table-cell><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>Xác thực / quyền</text:p></table:table-cell><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>Đầu vào (path/query/body)</text:p></table:table-cell><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>Đầu ra thành công</text:p></table:table-cell><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>HTTP status chính</text:p></table:table-cell><table:table-cell table:style-name="ce1" office:value-type="string"><text:p>Mô tả / lưu ý</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/register/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Không</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>JSON: name, email, phone_number, password</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>201: User {id,name,email,phone_number}; hoặc 200 {detail} khi email chưa xác thực đã tồn tại</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>201, 200, 400</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Đăng ký; gửi OTP email. password chỉ ghi, không trả về.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/verify-email/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Không</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>JSON: email, otp (6 ký tự)</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: {message}</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Kiểm tra OTP trong cache và đánh dấu tài khoản is_verify=true.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/login/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Không</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>JSON: email, password</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: {access, refresh}; đồng thời Set-Cookie access/refresh</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 401, 404</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Đăng nhập JWT. Token chứa claim email; cookies hiện không HttpOnly/Secure.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/refresh-token/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Không (cần cookie refresh)</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Cookie: refresh</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: {message}; Set-Cookie access mới</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400, 401, 500</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Làm mới access token từ cookie refresh; không đọc refresh token từ body.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/logout/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Bearer JWT</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Header: Authorization; Cookie: refresh</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: {message}; cookies access/refresh rỗng</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400, 401</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Đặt refresh token hết hạn và xóa cookies phía client.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/reset-password/?step=1</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Không</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>JSON: email</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: {message}</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400, 404</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Gửi OTP đặt lại mật khẩu.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/reset-password/?step=2</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Không</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>JSON: email, otp</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: {message}</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác nhận OTP trước khi đổi mật khẩu.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xác thực</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/auth/reset-password/?step=3</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Không</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>JSON: email, new_password</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: {message}</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Đổi mật khẩu. Lưu ý: view không ràng buộc OTP step 2 với step 3.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Nhà cung cấp</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>GET</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/suppliers/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Query tùy chọn: status, search</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: Supplier[]</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 401/403</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Liệt kê Supplier.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Nhà cung cấp</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/suppliers/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>company_name, contact_person, email, phone_number, address, tax_id, status, website, started_at (slug/id chỉ đọc)</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>201: Supplier</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>201, 400, 401/403</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Tạo Supplier.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Nhà cung cấp</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>GET</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/suppliers/{id}/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Path: id:int</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: Supplier</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 404, 401/403</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Lấy chi tiết Supplier.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Nhà cung cấp</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>PUT</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/suppliers/{id}/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Path: id:int; Body: company_name, contact_person, email, phone_number, address, tax_id, status, website, started_at (slug/id chỉ đọc)</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: Supplier</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400, 404, 401/403</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Cập nhật toàn bộ Supplier.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Nhà cung cấp</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>PATCH</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/suppliers/{id}/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Path: id:int; Body: các trường cần đổi trong company_name, contact_person, email, phone_number, address, tax_id, status, website, started_at (slug/id chỉ đọc)</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: Supplier</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 400, 404, 401/403</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Cập nhật một phần Supplier.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Nhà cung cấp</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>DELETE</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/suppliers/{id}/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Path: id:int</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>204: empty</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>204, 404, 401/403</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Xóa Supplier.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Danh mục</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>GET</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/categories/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>GET công khai; ghi Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Query tùy chọn: parent_id (null/0 hoặc ID)</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200: Category[]</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>200, 401/403</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Liệt kê Category.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>Danh mục</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>POST</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>/api/v1/categories/</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>GET công khai; ghi Bearer JWT + admin</text:p></table:table-cell><table:table-cell table:style-name="ce2" office:value-type="string"><text:p>name, 